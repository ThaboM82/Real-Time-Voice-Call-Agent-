{
  "name": "real-time-voice-call-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "real-time-voice-agent/backend"
  ],
  "scripts": {
    "lint:frontend": "eslint frontend/src",
    "lint:backend": "eslint real-time-voice-agent/backend/src",
    "lint:all": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "npm run test --workspace real-time-voice-agent/backend",
    "test:all": "npm run test:frontend && npm run test:backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace real-time-voice-agent/backend",
    "build:all": "npm run build:frontend && npm run build:backend",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace real-time-voice-agent/backend",
    "start:all": "concurrently -n frontend,backend -c blue,green \"npm run start:frontend\" \"npm run start:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace real-time-voice-agent/backend",
    "dev:all": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "ci:all": "npm run lint:all && npm run test:all && npm run build:all"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "concurrently": "^10.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.8.0",
    "jest": "29.0.0",
    "nodemon": "3.1.14",
    "typescript": "5.5.4"
  }
}
